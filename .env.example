# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=3000

# Matches docker-compose.yml
DATABASE_URL=postgres://capsule:capsule@localhost:5432/capsule

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated browser origins allowed to call the API (the web app's dev server).
CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# Optional locally, required in production. Prometheus sends it as a bearer token.
# METRICS_TOKEN=

# Model routing: provider:model per task. Swap these to move a task to another model.
OLLAMA_BASE_URL=http://localhost:11434
MODEL_VISION=ollama:gemma4:12b
MODEL_REASONING=ollama:gemma4:12b
MODEL_EMBEDDING=ollama:nomic-embed-text

# Photo storage (S3-compatible). These match docker-compose.yml and infra/seaweedfs-s3.json,
# which are for local development only. Browsers upload straight to S3_ENDPOINT.
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=capsule-photos
S3_ACCESS_KEY_ID=capsule
S3_SECRET_ACCESS_KEY=capsule-dev-secret
